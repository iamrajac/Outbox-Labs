PORT=4000
# Browser-facing origin. The Vite dev proxy makes API + OAuth callbacks share the frontend origin.
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgres://outbox:outbox@localhost:5432/outbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth (redirect URI: http://localhost:5173/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth (redirect URL: http://localhost:5173/api/slack/callback, scope: incoming-webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Mail: Ethereal accounts are created automatically and stored in the `senders` table.
MAIL_TRANSPORT=ethereal
SENDER_COUNT=3

# Throughput / rate limiting
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_SEND_ATTEMPTS=3
# Set true to run the worker inside the API process (handy for local demos)
EMBEDDED_WORKER=false
